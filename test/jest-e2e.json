{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "moduleNameMapper": {
    "^@evilcord/common$": "<rootDir>/../packages/common/src",
    "^@evilcord/types$": "<rootDir>/../packages/types/src"
  },
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  }
}
